{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && nest build",
    "prebuild": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "migrate:deploy": "prisma migrate deploy",
    "db:export": "ts-node -r tsconfig-paths/register prisma/export-reference-data.ts",
    "db:import": "ts-node -r tsconfig-paths/register prisma/import-reference-data.ts",
    "seed:admin": "ts-node -r tsconfig-paths/register prisma/seed-admin.ts",
    "seed:roles": "ts-node -r tsconfig-paths/register prisma/seed-roles.ts",
    "seed:barcodes:demo": "ts-node -r tsconfig-paths/register prisma/seed-barcodes-demo.ts",
    "seed:notifications:demo": "ts-node -r tsconfig-paths/register --transpile-only prisma/seed-demo-notifications.ts",
    "seed:barcodes": "ts-node -r tsconfig-paths/register --transpile-only prisma/enrich-barcodes.ts",
    "seed:barcodes:enrich": "ts-node -r tsconfig-paths/register --transpile-only prisma/enrich-barcodes.ts",
    "seed:demo:prices": "ts-node -r tsconfig-paths/register prisma/seed-demo-prices.ts",
    "db:seed": "prisma db seed",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "seed:prices": "ts-node -r tsconfig-paths/register prisma/seed-prices.ts",
    "seed:prices:gaps": "ts-node -r tsconfig-paths/register prisma/seed-prices.ts -- --gaps-only",
    "seed:rewards": "ts-node -r tsconfig-paths/register prisma/seed-rewards.ts",
    "seed:branches": "ts-node -r tsconfig-paths/register prisma/seed-branches.ts",
    "seed:enrich-products": "ts-node -r tsconfig-paths/register prisma/seed-enrich-products.ts",
    "seed:enrich-missing": "ts-node -r tsconfig-paths/register prisma/seed-enrich-missing-images.ts",
    "seed:image-pipeline": "ts-node -r tsconfig-paths/register prisma/image-pipeline.ts",
    "seed:reclassify": "ts-node -r tsconfig-paths/register prisma/reclassify-products.ts",
    "seed:reactivate": "ts-node -r tsconfig-paths/register prisma/reactivate-products.ts",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1019.0",
    "@aws-sdk/lib-storage": "^3.1019.0",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.14.0",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.1",
    "openai": "^6.33.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^7.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
