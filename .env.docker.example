# =====================================================
# Production Docker Compose ortam degiskenleri
# Kopyala: copy .env.docker.example .env.docker (Windows)
# =====================================================

# --- Veritabani (GUCLU SIFRE KULLANIN) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password_32chars
POSTGRES_DB=marketapp

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# --- MinIO / S3 ---
S3_ACCESS_KEY=CHANGE_ME_minio_access_key
S3_SECRET_KEY=CHANGE_ME_minio_secret_key_min_16chars
S3_BUCKET=marketapp
S3_REGION=us-east-1

# --- Backend JWT (en az 32 karakter, farkli degerler) ---
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_different_32chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS (virgulle ayrilmis tam origin URL'leri) ---
CORS_ORIGINS=https://admin.yourdomain.com,https://yourdomain.com
ADMIN_PANEL_URL=https://admin.yourdomain.com
FRONTEND_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com

# --- Portlar (host mapping) ---
BACKEND_PORT=3000
ADMIN_PORT=3001

# --- Admin panel (Docker profili with-admin) ---
NEXT_PUBLIC_API_URL=/api

# --- Opsiyonel servisler ---
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PREFERRED_PROVIDER=gemini
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# --- Scraper / sync (production'da dikkatli acin) ---
PRICE_SCRAPER_ENABLED=true
DATA_SYNC_CRON_ENABLED=true
ALLOW_DEMO_SEED=false
