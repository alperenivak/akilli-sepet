# =====================================================
# MarketApp - Ortam Degiskenleri Sablonu
# 
# KURULUM:
#   1. Bu dosyayi backend/.env olarak kopyalayin:
#      cp .env.example backend/.env   (Mac/Linux)
#      copy .env.example backend\.env (Windows)
#   2. Zorunlu alanlari doldurun
#   3. docker-compose up -d calistirin
#   4. start.ps1 (Windows) veya ./start.sh (Mac/Linux)
# =====================================================

# =====================================================
# ZORUNLU — Bunlar olmadan uygulama calismaz
# =====================================================

# PostgreSQL (docker-compose ile otomatik olusur)
DATABASE_URL="postgresql://postgres:123456@localhost:5432/marketapp?schema=public"

# JWT Gizli Anahtarlar (degistirin! En az 32 karakter)
JWT_SECRET=super-secret-jwt-key-change-in-production-at-least-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production-at-least-32
JWT_REFRESH_EXPIRES_IN=30d

# Uygulama
NODE_ENV=development
PORT=3000

# =====================================================
# OPSIYONEL — Yoksa ilgili ozellik calismaaz,
# ama uygulama AYAGA KALKAR
# =====================================================

# Redis (docker-compose ile otomatik baslar)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO S3 Dosya Depolama (docker-compose ile baslar)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=marketapp

# Firebase Push Bildirimler (bos birakilabilir)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Yapay Zeka — ChatGPT tarzı sohbet (Gemini UCRETSIZ önerilir)
# Kurulum: .\scripts\setup-gemini-key.ps1
# OpenAI: https://platform.openai.com/api-keys (ucretli)
OPENAI_API_KEY=
# Google Gemini: https://aistudio.google.com/app/apikey (ucretsiz, kredi karti yok)
GEMINI_API_KEY=
AI_PREFERRED_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Frontend URL'leri (CORS) — production'da tam origin URL (https://...)
FRONTEND_URL=http://localhost:3001
ADMIN_PANEL_URL=http://localhost:3000
MOBILE_URL=exp://localhost:8081
# Virgulle ayrilmis izinli origin listesi (production zorunlu)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_URL=http://localhost:3001

# Veri Senkronizasyonu (dis kaynak cekimi varsayilan KAPALI)
DATA_SYNC_CRON_ENABLED=true
DATA_SYNC_EXTERNAL_PROVIDERS_ENABLED=false
DATA_SYNC_PRICE_STALE_DAYS=7
DATA_SYNC_PRICE_FRESH_DAYS=3
# Demo seed API uzerinden (production'da false birakin)
ALLOW_DEMO_SEED=false

# E-posta OTP (kayit + sifre sifirlama) — brevo veya resend zorunlu
EMAIL_PROVIDER=resend
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Akilli Sepet
RESEND_API_KEY=re_xxxxxxxx
# Alternatif: EMAIL_PROVIDER=brevo + BREVO_API_KEY=xkeysib-xxxxxxxx
EMAIL_OTP_EXPIRES_MINUTES=10
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60

# Fiyat Scraper — Migros API + sitemap (gece 03:00 cron)
PRICE_SCRAPER_ENABLED=true
PRICE_SCRAPER_SYNC_ON_STARTUP=true
PRICE_SCRAPER_DEACTIVATE_DEMO=true
PRICE_SCRAPER_MAX_PRODUCTS=300
PRICE_SCRAPER_API_MIN_DELAY_MS=800
PRICE_SCRAPER_API_MAX_DELAY_MS=2000
PRICE_SCRAPER_MIGROS_MAX_PAGES=3
PRICE_SCRAPER_MIN_DELAY_MS=3000
PRICE_SCRAPER_MAX_DELAY_MS=7000
PRICE_SCRAPER_NAME_SELECTOR=.product-name
PRICE_SCRAPER_PRICE_SELECTOR=.product-price
PRICE_SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
