{
  "expo": {
    "name": "Akıllı Sepet",
    "slug": "akilli-sepet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.akillisebet.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Urun barkodunu okumak icin kamera gereklidir",
        "NSLocationWhenInUseUsageDescription": "Yakin marketleri bulmak icin konum bilgisi gereklidir",
        "NSPhotoLibraryUsageDescription": "Ihbar fotografı yuklemek icin galeri erisimi gereklidir"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.akillisebet.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Urun barkodunu okumak icin kamera izni gerekli"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Yakin marketleri bulmak icin konum izni"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ihbar fotografı eklemek icin galeri izni"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "akillisebet",
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
